# Used by `npm run dev:emulators` (vite --mode emulators). Points the app at the
# local Firebase Emulator Suite under a "demo-" project, which the emulators
# keep fully offline — nothing here can touch the live project. These are
# placeholder values, not secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-scheduler.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-scheduler
VITE_FIREBASE_STORAGE_BUCKET=demo-scheduler.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
